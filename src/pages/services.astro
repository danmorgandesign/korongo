---
import { TextSection } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import HeroSection from '../components/sections/heros/HeroSection.astro';

const seo = {
	title: 'Services | Korongo',
	description: 'Services Page',
};
---

<Layout {seo}>
	<HeroSection>
		<div slot="text-container">
			<h1>Our Services</h1>
			<p>
				Here's how we can help your business grow.
			</p>
		</div>
    <picture slot="image-container">
      <img
        src="/assets/images/home/classic-hero.jpg"
        alt="Astro Odyssee"
        id="home-hero-image"
      />
    </picture>
	</HeroSection>
  <TextSection narrow>
    <p>Services content coming soon.</p>
  </TextSection>
</Layout>
