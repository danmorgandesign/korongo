---
import { Icon } from 'astro-icon/components';
import { Button, TextSection, CtaCardSection, Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import HeroSection from '../components/sections/heros/HeroSection.astro';

const seo = {
	title: 'About | Korongo',
	description: 'Korongo is a no-jargon web design studio helping startups, creatives, and small to medium businesses get online with clear advice and websites that actually work.',
};

const services = [
	{ icon: 'mdi:web', label: 'Web Design' },
	{ icon: 'mdi:palette-swatch-outline', label: 'UX Design' },
	{ icon: 'mdi:school-outline', label: 'Tech Training' },
	{ icon: 'mdi:share-variant-outline', label: 'Social Media Setup' },
	{ icon: 'mdi:strategy', label: 'Strategic Planning' },
	{ icon: 'mdi:lightbulb-on-outline', label: 'Simple Advice' },
];
---

<Layout {seo}>
	<div class="about-hero">
	<HeroSection>
		<div slot="text-container">
			<h1>About Korongo</h1>
			<p>
				We're the crane you call in when your business needs a lift online.
				No jargon, no bloated agency process — just clear advice and a
				website that actually works for you.
			</p>
		</div>
    <picture slot="image-container">
      <img
        src="/assets/images/simba.jpg"
        alt="Simba"
        id="home-hero-image"
      />
    </picture>
	</HeroSection>
	</div>

	<Container>
		<div class="about-services__section">
			<div class="about-services__grid">
				{services.map((service) => (
					<div class="about-services__card">
						<Icon name={service.icon} width="28" height="28" />
						<span>{service.label}</span>
					</div>
				))}
			</div>
			<div class="about-services__btn">
				<Button href="/contact" customIcon
					>Book a Call <Fragment slot="icon">
						<Icon name="ic:baseline-chevron-right" />
					</Fragment></Button
				>
			</div>
		</div>
	</Container>

  <TextSection narrow>
    <p>
      Most small businesses don't need a retainer, a twelve-week discovery phase, or a website stuffed with features nobody asked for. They need something that looks good, works properly, and doesn't take six months to get live. That's the gap Korongo fills - practical, jargon-free help for people who'd rather be running their business than wrestling with a content management system.
    </p>
    <p>We start with a conversation, not a sales pitch. If a full rebuild isn't what you need, we'll say so. Sometimes the answer is a few tweaks, a clearer message, or some straightforward training so you can manage things yourself. We'd rather give you honest advice than sell you something you don't need.</p>

    <p>
      Our work covers the full range of getting, and keeping, a business online. Web Design for new sites built to convert, not just look nice. UX Design that makes sure visitors actually find what they're looking for. Tech Training so your team isn't stuck calling us for every small change. Social Media Setup to get your channels looking sharp and linked up properly. Strategic Planning to map out where your online presence needs to go next. And Simple Advice, for when all you need is a straight answer from someone who knows the tech stuff.
    </p>
    <p>
      Whatever stage you're at, starting from scratch, patching up an old site, or just after a second opinion. Korongo is here to give your business the lift it needs.
    </p>
  </TextSection>

	<CtaCardSection
		background="var(--theme-surface-2)"
		color="var(--theme-on-surface-2)"
	>
		<h2>Start Your Website Today</h2>
		<p>
			It only takes a couple of clicks to have a new, modern website for your
			business or startup.
		</p>
		<Button href="/contact" customIcon
			>Book a Call <Fragment slot="icon">
				<Icon name="ic:baseline-chevron-right" />
			</Fragment></Button
		>
	</CtaCardSection>
</Layout>

<style>
	.about-hero :global(.hero-section__text) {
		order: 2;
	}
	.about-hero :global(.hero-section__image) {
		order: 1;
	}
	.about-services__section {
		margin: var(--section-margin) auto;
	}
	.about-services__grid {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr;
		gap: 0.75rem;
	}
	.about-services__btn {
		display: flex;
		justify-content: center;
		margin-top: calc(var(--section-margin) / 2);
	}
	.about-services__card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 0.4rem;
		padding: 0.75rem 0.5rem;
		background-color: var(--theme-surface-1);
		color: var(--theme-on-surface-1);
		border-radius: var(--theme-shape-radius);
	}
	.about-services__card span {
		font-weight: 600;
		font-size: 0.75rem;
	}
	@media (max-width: 768px) {
		.about-services__grid {
			grid-template-columns: 1fr 1fr 1fr;
		}
	}
	@media (max-width: 480px) {
		.about-services__grid {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
