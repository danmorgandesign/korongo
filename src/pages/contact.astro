---
import Layout from '../layouts/Page.astro';
import LandingContactForm from '../components/forms/LandingContactForm.astro';

const seo = {
	title: 'Contact | Korongo',
	description: 'Get in touch with Korongo to talk about your website or online presence — clear advice for startups, creatives, and small to medium businesses.',
};
---

<Layout seo={seo}>
  <div class="full-page-split__wrapper">
    <section class="full-page-split__image-section">
      <picture>
        <img
          src="/assets/images/landing-1/crane.svg"
          alt="Astro Korongo"
          class="full-page-split__image"
        />
      </picture>
    </section>
    <section class="full-page-split__content-section">
      <div class="full-page-split__content-container">
        <h1>Drop us your deets and we'll get in touch.</h1>
        <p>Fill out your contact info and we'll get in touch to discuss how we can give you a lift.</p>
        <LandingContactForm/>
      </div>
    </section>
  </div>
</Layout>

<style>
.full-page-split__wrapper {
  display: grid;
  grid-template-columns: 4fr 6fr;
  grid-template-rows: minmax(28rem, 44rem);
  grid-auto-columns: 1fr;
}
.full-page-split__image-section {
  position: relative;
  overflow: hidden;
  background-color: #fff;
}
.full-page-split__image-section picture {
  position: absolute;
  inset: 0;
}
.full-page-split__image-section :global(img) {
  position: absolute;
  inset: 0;
  width: 50%;
  height: 50%;
  margin: auto;
  object-fit: contain;
}
.full-page-split__content-section {
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}
.full-page-split__content-container {
  margin: 1rem;
  padding: 2rem;
}
.full-page-split__content-container h1 {
  font-size: var(--font-size-xl);
}
@media(max-width: 768px) {
  .full-page-split__wrapper {
    grid-template-columns: 1fr;
    grid-template-rows: 30vh auto;
  }
}
</style>
