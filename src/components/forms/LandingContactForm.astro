---
import {Icon} from 'astro-icon/components'
import { Button, FormInput } from '@components/odyssey-theme';

// Get a free access key at https://web3forms.com/ (just enter an email, no signup) and paste it below.
const WEB3FORMS_ACCESS_KEY = '599bff98-8769-45e7-ad2f-a638440d81c0';
---

<form id="contact-form" name="Contact Form">
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value="New contact form submission - Korongo" />
  <input type="checkbox" name="botcheck" class="hidden-field" tabindex="-1" autocomplete="off" />
  <FormInput type="text" label="First Name" name="First Name" placeholder="Jeff" required />
  <FormInput type="text" label="Last Name" name="Last Name" placeholder="Dude" required />
  <FormInput type="email" label="Email" name="Email" placeholder="thedude@yoursite.co.uk" required />
  <FormInput type="tel" label="Phone" name="Phone" placeholder="01234 567890" />
  <Button customIcon type="submit">Submit
    <Fragment slot="icon">
      <Icon name="ic:baseline-chevron-right" />
    </Fragment>
  </Button>
  <p class="form-status" role="status"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector<HTMLParagraphElement>('.form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (status) status.textContent = 'Sending...';

    const formData = new FormData(form);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (result.success) {
        window.location.href = '/contact-thank-you';
      } else if (status) {
        status.textContent = result.message || 'Something went wrong. Please try again.';
      }
    } catch {
      if (status) status.textContent = 'Something went wrong. Please try again.';
    }
  });
</script>

<style>
  form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  form :global(.form-field__container) {
    max-width: 50%;
  }
  .hidden-field {
    display: none;
  }
  .form-status:empty {
    display: none;
  }
</style>
